NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://staging.mapmycore.com
# Production only: lets search engines and AI crawlers index the public pages.
SITE_INDEXABLE=false
# Staging-only session replay. Leave disabled in production.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Session replay is separate from analytics; leave off unless needed.
NEXT_PUBLIC_POSTHOG_REPLAY=false
# Transactional email (Amazon SES): parent reminder, Kai safeguarding alert.
EMAIL_FROM="Map My CORE <support@mapmycore.com>"
SES_REGION=eu-north-1
SAFEGUARDING_ALERT_TO=enas@mapmycore.com
# Complete report offer. Amount is stored in the currency's minor unit.
NEXT_PUBLIC_REPORT_LIST_PRICE_MINOR=45000
NEXT_PUBLIC_REPORT_OFFER_PERCENT=20
NEXT_PUBLIC_REPORT_CURRENCY=AED
# Optional: a Stripe coupon (e.g. 20% off) applied to every report checkout so the charge matches the offer.
STRIPE_REPORT_COUPON_ID=

SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ELEVENLABS_API_KEY=
# English (default) Kai voice
ELEVENLABS_VOICE_ID=ZF6FPAbjXT4488VcRRnw
# Arabic Kai voice (used when locale=ar)
ELEVENLABS_VOICE_ID_AR=KxMRrXEjbJ6kZ93yT3fq
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=global
GOOGLE_OAUTH_ACCESS_TOKEN=
TAREEQ_AUDIO_LOCALE=en
NOUR_SPEAKER_WAV=

# Stripe — report checkout. Secret key and webhook secret are server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Switch real students onto CORE 2.0 (question set 5.1 + new report). Off by default.
NEXT_PUBLIC_CORE_V2_LIVE=false
