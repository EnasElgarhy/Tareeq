{
  "name": "tareeq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:isolation": "tsx scripts/verify_user_data_isolation.ts",
    "kai:quality": "tsx scripts/stress_test_kai_quality.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed_db.ts",
    "audio:generate-clips": "tsx scripts/generate_audio_clips.ts",
    "audio:bake:english-assessment": "tsx scripts/bake_english_assessment_audio.ts",
    "audio:bake": "python3 prototype/bake_audio.py --source seed --out-dir public/audio",
    "audio:bake:force": "python3 prototype/bake_audio.py --source seed --out-dir public/audio --force",
    "audio:bake:dry": "python3 prototype/bake_audio.py --source seed --out-dir public/audio --dry-run",
    "audio:bake:elevenlabs": "python3 prototype/bake_audio.py --provider elevenlabs --source seed --out-dir public/audio",
    "audio:bake:elevenlabs:dry": "python3 prototype/bake_audio.py --provider elevenlabs --source seed --out-dir public/audio --dry-run",
    "audio:warm": "python3 scripts/warm_audio.py --in-dir public/audio --out-dir public/audio",
    "audio:bake:xtts:dry": "python3 prototype/bake_audio.py --provider xtts --locale ar --html prototype/index.html --out-dir public/audio_ar --dry-run"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.88.0",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.561.0",
    "next": "^15.0.0",
    "next-intl": "^4.6.1",
    "postgres": "^3.4.7",
    "posthog-js": "^1.406.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.181.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.0.10",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
