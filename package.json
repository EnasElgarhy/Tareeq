{
  "name": "tareeq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed_db.ts",
    "audio:bake": "python3 prototype/bake_audio.py --html prototype/index.html --out-dir public/audio",
    "audio:bake:force": "python3 prototype/bake_audio.py --html prototype/index.html --out-dir public/audio --force",
    "audio:bake:dry": "python3 prototype/bake_audio.py --html prototype/index.html --out-dir public/audio --dry-run",
    "audio:bake:xtts:dry": "python3 prototype/bake_audio.py --provider xtts --locale ar --html prototype/index.html --out-dir public/audio_ar --dry-run"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.88.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.561.0",
    "next": "^15.0.0",
    "next-intl": "^4.6.1",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.181.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.0.10",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
